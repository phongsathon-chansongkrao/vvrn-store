# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

# The frontend's address (used for CORS and cookies)
CLIENT_ORIGIN=http://localhost:5173

# ---- SQL Server ----
DB_SERVER=localhost
# Use DB_PORT for a default instance. For a named instance such as SQLEXPRESS,
# leave DB_PORT empty and set DB_INSTANCE=SQLEXPRESS (SQL Server Browser must be running).
DB_PORT=1433
DB_INSTANCE=
DB_NAME=VVRN
DB_USER=vvrn_app
DB_PASSWORD=ChangeMe_Str0ng!Pass
# Local SQL Server usually has a self-signed certificate:
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ---- Security ----
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---- Email (order confirmation + status updates) ----
# Leave RESEND_API_KEY empty in development: emails are saved to backend/mail-outbox/ instead of sent.
# Get a key at https://resend.com. To email real customers, verify your domain there and change MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM=VVRN <onboarding@resend.dev>
MAIL_REPLY_TO=
# Development only: redirect every email to this address (e.g. the email you signed up to Resend with).
# Ignored when NODE_ENV=production.
MAIL_TEST_TO=
